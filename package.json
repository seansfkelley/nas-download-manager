{
  "name": "nas-download-manager",
  "version": "0.0.0",
  "description": "An open source browser extension for adding/managing download tasks to your Synology DiskStation.",
  "scripts": {
    "test": "jest",
    "lint": "prettier --check \"src/**/*\" \"test/**/*\"",
    "typecheck": "tsc -p src --noemit && tsc -p test --noemit",
    "check:dist": "web-ext lint --source-dir dist",
    "dev": "web-ext run --source-dir dist --target firefox-desktop",
    "watch": "parcel watch manifest.json --no-hmr",
    "dist": "rm -rf dist && parcel build manifest.json --no-source-maps",
    "package": "npm run dist && npm run check:dist && npm run zip",
    "zip": "rm -f addon.zip && cd dist && zip -qr ../addon.zip . -x '**/*.map' -x '**/.DS_Store'",
    "zip-sources": "rm -f sources.zip && zip -qr sources.zip . -x '*.zip' -x 'dist/*' -x 'node_modules/*' -x '**/.DS_Store' -x '.git/*' -x '.cache/*' -x '.parcel-cache/*' -x '.vscode/*' -x '.github/*' -x '.circleci/*'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seansfkelley/nas-download-manager.git"
  },
  "license": "MIT",
  "@parcel/bundler-default": {
    "maxParallelRequests": 1
  },
  "staticFiles": {
    "staticPath": "icons",
    "staticOutPath": "icons"
  },
  "browserslist": [
    "last 2 Firefox versions",
    "Firefox ESR",
    "last 2 Chrome versions"
  ],
  "devDependencies": {
    "@parcel/config-webextension": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/glob": "^5.0.33",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.141",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "glob": "^7.1.2",
    "jest": "^30.4.2",
    "jest-extended": "^6.0.0",
    "parcel": "^2.16.4",
    "parcel-reporter-static-files-copy": "1.5.3",
    "prettier": "^3.9.6",
    "sass": "^1.22.10",
    "semver": "^7.3.4",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "web-ext": "^10.6.0"
  },
  "dependencies": {
    "classnames": "^2.3.1",
    "lodash": "^4.17.21",
    "query-string": "^6.8.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-textarea-autosize": "^8.5.9"
  }
}
