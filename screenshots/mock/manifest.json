{
  "manifest_version": 3,
  "name": "NAS Download Manager (for Synology)",
  "version": "0.0.0",
  "description": "__MSG_Add_and_manage_Download_Station_tasks_on_your_Synology_DiskStation__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "{a7e6b1c4-3f52-4d8a-9b0e-7c1d2f6a4b83}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["contextMenus", "notifications"],
  "background": {
    "service_worker": "background.ts",
    "scripts": ["background.ts"],
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["links.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "NAS Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "../../icons/icon-16.png",
      "32": "../../icons/icon-32.png",
      "64": "../../icons/icon-64.png",
      "128": "../../icons/icon-128.png",
      "256": "../../icons/icon-256.png"
    }
  },
  "icons": {
    "16": "../../icons/icon-16.png",
    "32": "../../icons/icon-32.png",
    "64": "../../icons/icon-64.png",
    "128": "../../icons/icon-128.png",
    "256": "../../icons/icon-256.png"
  }
}
