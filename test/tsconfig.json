{
  "extends": "../src/tsconfig.json",
  "compilerOptions": {
    // Jest runs CommonJS, which cannot pair with the source config's "bundler" resolution.
    // "node16" emits CommonJS here because package.json has no "type": "module". node10 would
    // also work but does not understand package "exports" and stops functioning in TypeScript 7.
    "module": "node16",
    "moduleResolution": "node16",
    // ts-jest builds its own file list, which loses the automatic @types inclusion that tsc does.
    // firefox-webext-browser is named in the source config too, and a "types" array replaces rather
    // than extends the inherited one, so it has to be repeated here.
    "types": ["firefox-webext-browser", "jest", "jest-extended", "node"],
    "rootDir": ".."
  },
  // The ambient declarations under src/ are not reachable from the test files' imports.
  "include": [".", "../src/**/*.d.ts"]
}
