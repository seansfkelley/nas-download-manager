{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    // The global `browser` namespace comes from an ambient declaration that nothing imports, so it
    // has to be named here. Automatic @types inclusion does not pick it up for this project.
    "types": ["firefox-webext-browser"]
  },
  "exclude": ["node_modules", "lib"]
}
